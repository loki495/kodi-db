# Copy to .env and fill in real values — .env is gitignored
# See README.md for details.

# --- MariaDB (docker-compose) ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=kodi
MYSQL_USER=kodi
MYSQL_PASSWORD=changeme
# Host port mapped to container 3306
MYSQL_PORT=3308

# --- Sync target (MySQL Kodi library) ---
# Host/port/database used by update-db.py / pull-and-update.sh
MYSQL_HOST=127.0.0.1
MYSQL_DB=MyVideos121
# Note: MYSQL_USER / MYSQL_PASSWORD / MYSQL_PORT above are reused for the sync connection.
# If the sync target differs from the docker DB, override here:
# SYNC_MYSQL_HOST=
# SYNC_MYSQL_PORT=
# SYNC_MYSQL_USER=
# SYNC_MYSQL_PASSWORD=
# SYNC_MYSQL_DB=

# --- Shield / ADB ---
ADB_TARGET=192.168.1.10:5555
KODI_REMOTE_DB_PATTERN=/sdcard/Android/data/org.xbmc.kodi/files/.kodi/userdata/Database/MyVideos*.db
# Filename expected after pull (version-specific). If empty, the newest MyVideos*.db is used.
SQLITE_DB_FILENAME=MyVideos131.db

# --- Paths ---
TMP_DIR=./kodi_db_tmp
